<Project Sdk="Microsoft.NET.Sdk">

	<!-- The Visual Studio extension: the previewer's tool window, .zss highlighting
	     and .zss problems in the Error List. Builds with Visual Studio's MSBuild on
	     Windows only — open ZeppelinForms.VisualStudio.sln — which is why it is not
	     in the main solution that CI builds with dotnet on Linux too. -->

	<PropertyGroup>
		<TargetFramework>net472</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<RootNamespace>ZeppelinForms.VisualStudio</RootNamespace>
		<AssemblyName>ZeppelinForms.VisualStudio</AssemblyName>
		<IsPackable>false</IsPackable>

		<!-- VSIX -->
		<!-- the .vsix itself. Inside Visual Studio the IDE asks for it; a command-line
		     MSBuild — CI, the release — built the extension without packing it, and
		     there was no .vsix to attach -->
		<CreateVsixContainer>true</CreateVsixContainer>
		<GeneratePkgDefFile>true</GeneratePkgDefFile>
		<UseCodebase>true</UseCodebase>
		<IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
		<IncludeDebugSymbolsInVSIXContainer>true</IncludeDebugSymbolsInVSIXContainer>
		<IncludeDebugSymbolsInLocalVSIXDeployment>true</IncludeDebugSymbolsInLocalVSIXDeployment>
		<CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
		<CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
		<StartAction>Program</StartAction>
		<StartProgram>$(DevEnvDir)devenv.exe</StartProgram>
		<StartArguments>/rootsuffix Exp</StartArguments>

		<!-- the solution's rule — a warning breaks the build — is kept for the
		     framework. Here the VS SDK's threading analyzers apply, the project is
		     built outside CI, and a first build should not fail on a style rule -->
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
	</PropertyGroup>

	<!-- what marks an SDK-style project as an extension to the VS SDK's build:
	     without it the container targets don't take the project for a VSIX one -->
	<ItemGroup>
		<ProjectCapability Include="CreateVsixContainer" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.VisualStudio.SDK" ExcludeAssets="runtime" />
		<PackageReference Include="Microsoft.VSSDK.BuildTools" />
	</ItemGroup>

	<ItemGroup>
		<!-- .NET Framework assemblies an SDK-style project doesn't reference by itself:
		     the VS SDK's command and service types derive from System.Design's -->
		<Reference Include="System.Design" />
	</ItemGroup>

	<ItemGroup>
		<!-- the wire protocol is one file shared with the host -->
		<Compile Include="..\ZeppelinForms.Design\Protocol\DesignerProtocol.cs" Link="Protocol\DesignerProtocol.cs" />
	</ItemGroup>

	<ItemGroup>
		<None Include="source.extension.vsixmanifest" SubType="Designer" />
		<VSCTCompile Include="ZeppelinForms.vsct" ResourceName="Menus.ctmenu" />

		<Content Include="Grammars\**\*" IncludeInVSIX="true" />
		<Content Include="ZeppelinForms.pkgdef" IncludeInVSIX="true" />
		<Content Include="Resources\Icon.png" IncludeInVSIX="true" />
	</ItemGroup>

	<!-- The host process goes into the extension, published next to it in Designer\.
	     dotnet publish rather than an MSBuild call: the host is .NET 10, and the
	     MSBuild of an older Visual Studio may not know that SDK.

	     Not in design-time builds: Visual Studio runs those on load and on edits,
	     and each would start a publish of its own.

	     The publish builds into its own artifacts folder. Visual Studio builds the
	     same projects — the Designer, ZeppelinForms, Skia — at the same time when
	     they are in the open solution; sharing their obj folders, two builds delete
	     and rewrite each other's files (the sourcelink.json error).

	     The paths have no trailing backslash: inside quotes "dir\" reads as an
	     escaped quote, and the argument runs on into the next one. -->
	<Target Name="PublishDesignerHost" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
		<PropertyGroup>
			<DesignerHostOutput>$(MSBuildProjectDirectory)\obj\Designer</DesignerHostOutput>
			<DesignerHostArtifacts>$(MSBuildProjectDirectory)\obj\DesignerBuild</DesignerHostArtifacts>
		</PropertyGroup>

		<Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)\..\ZeppelinForms.Designer\ZeppelinForms.Designer.csproj&quot; -c $(Configuration) -o &quot;$(DesignerHostOutput)&quot; --artifacts-path &quot;$(DesignerHostArtifacts)&quot; --nologo" />

		<ItemGroup>
			<Content Include="$(DesignerHostOutput)\**\*" IncludeInVSIX="true" VSIXSubPath="Designer\%(RecursiveDir)" />
		</ItemGroup>
	</Target>

</Project>