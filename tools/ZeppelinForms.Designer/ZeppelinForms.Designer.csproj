<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Description>The previewer's host process: started by an IDE extension, it loads the project's build and draws its previews with Skia.</Description>
		<IsPackable>false</IsPackable>

		<!-- the IDE starts it with whatever .NET the machine has: a newer runtime
		     runs it as well, the way it runs the projects it previews -->
		<RollForward>Major</RollForward>
	</PropertyGroup>


	<ItemGroup>
		<!-- Windows for Visual Studio; Linux for Rider and VS Code. macOS comes with
		     SkiaSharp and HarfBuzzSharp themselves: they depend on their macOS and
		     Windows modules, not on the Linux ones -->
		<PackageReference Include="SkiaSharp" />
		<PackageReference Include="SkiaSharp.NativeAssets.Win32" />
		<PackageReference Include="SkiaSharp.NativeAssets.Linux" />
		<PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" />
	</ItemGroup>


	<ItemGroup>
	  <ProjectReference Include="..\..\src\ZeppelinForms.Skia\ZeppelinForms.Skia.csproj" />
	  <ProjectReference Include="..\..\src\ZeppelinForms\ZeppelinForms.csproj" />
	  <ProjectReference Include="..\ZeppelinForms.Design\ZeppelinForms.Design.csproj" />
	</ItemGroup>

</Project>