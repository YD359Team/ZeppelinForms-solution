<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<!-- суффикс -browser обязателен: без него нет JSImport/JSExport -->
		<TargetFramework>net10.0-browser</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- Span<byte> поверх неуправляемого буфера кадра -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\ZeppelinForms\ZeppelinForms.csproj" />
		<ProjectReference Include="..\ZeppelinForms.Skia\ZeppelinForms.Skia.csproj" />
	</ItemGroup>

	<!-- wwwroot\zf.js объявлять не надо: Razor SDK сам раздаёт его
       потребителям по адресу _content/ZeppelinForms.Browser/zf.js,
       и копия в каждом приложении больше не нужна -->

	<ItemGroup>
		<PackageReference Include="SkiaSharp" Version="4.151.2" />
		<PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="4.151.2" />
	</ItemGroup>

</Project>