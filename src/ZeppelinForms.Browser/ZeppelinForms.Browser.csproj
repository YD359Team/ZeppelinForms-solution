<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- суффикс -browser обязателен: без него нет JSImport/JSExport -->
		<TargetFramework>net10.0-browser</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- Span<byte> поверх неуправляемого буфера кадра -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Description>The WebAssembly platform of ZeppelinForms: a canvas hosting the forms, pointer and keyboard input, and an ARIA mirror for screen readers. The page needs the zf.js module, attached to every release.</Description>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\ZeppelinForms\ZeppelinForms.csproj" />
		<ProjectReference Include="..\ZeppelinForms.Skia\ZeppelinForms.Skia.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- эталон модуля. В приложение не копируется: там лежит своя копия
         в wwwroot, а этот файл здесь как исходник -->
		<None Include="zf.js" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="SkiaSharp" />
		<PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" />
	</ItemGroup>

</Project>