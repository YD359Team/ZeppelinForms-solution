# The analyzers of the framework itself: AnalysisLevel latest-recommended (see the
# project file). These are the rules it deliberately departs from, each with its reason.

[*.cs]

# The framework's event data are records, and a record can't derive from
# System.EventArgs; the EventArgs suffix still tells what they are
dotnet_code_quality.CA1711.allowed_suffixes = EventArgs

# Names that are keywords of other .NET languages — Select, End, Stop, Exit, To —
# where they are the natural name: the framework targets C#, and C# can call them
dotnet_diagnostic.CA1716.severity = none

# Single, Decimal, Float name what they are: a selection of one item, the keypad's
# decimal key, a float interpolator — as WinForms and WPF name them too
dotnet_diagnostic.CA1720.severity = none
