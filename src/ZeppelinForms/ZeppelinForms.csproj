<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Description>A cross-platform UI framework drawn with SkiaSharp: controls, layout, themes, input, animation and accessibility. Add the package of your platform — ZeppelinForms.Windows, .Linux, .Android or .Browser — to run it.</Description>

		<!-- the XML documentation goes into the package: IntelliSense of the
         applications shows the summaries. Not every public member has one yet
         (CS1591), and not every documented method documents every parameter
         (CS1573): those two are not errors here -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>

		<!-- the analyzers ship inside this package: see _ZfAnalyzersInPackage -->
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_ZfAnalyzersInPackage</TargetsForTfmSpecificContentInPackage>

		<!-- Trimming and native AOT: the trim, AOT and single-file analyzers run on
		     every build, and with TreatWarningsAsErrors a reflection the trimmer can't
		     follow fails the build here rather than an application's publish. The
		     package is also marked trimmable for the applications that use it -->
		<IsAotCompatible>true</IsAotCompatible>

		<!-- One step stricter than the rest of the solution: the recommended set of
		     the .NET analyzers. The rules it departs from are in
		     ZeppelinForms.globalconfig here, each with its reason -->
		<AnalysisLevel>latest-recommended</AnalysisLevel>
	</PropertyGroup>

	<!-- The departures from the recommended set. Given by name, not discovered by
	     folder: a nested .editorconfig was lost on a mapped drive, where its path
	     and the sources' paths were spelled differently -->
	<ItemGroup>
		<GlobalAnalyzerConfigFiles Include="ZeppelinForms.globalconfig" />
	</ItemGroup>

	<!-- The public API is declared in PublicAPI.Shipped.txt (what 0.14.1 had) and
	     PublicAPI.Unshipped.txt (what this release adds): a public member added, changed
	     or removed without the files saying so is a build error (RS0016, RS0017), so a
	     change of the API is always a visible line in a review. At a release the
	     Unshipped lines move to Shipped -->
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
		<AdditionalFiles Include="PublicAPI.Shipped.txt" />
		<AdditionalFiles Include="PublicAPI.Unshipped.txt" />
	</ItemGroup>

	<!-- What an application gets with the package besides the assemblies: the feature
	     switch that turns off the styles' assembly scanning where trimming would break
	     it, see buildTransitive/ZeppelinForms.targets -->
	<ItemGroup>
		<None Include="buildTransitive\ZeppelinForms.targets" Pack="true" PackagePath="buildTransitive\" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="Resources\ZF_13.ico" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\ZF_13.ico" />
	</ItemGroup>

	<ItemGroup>
		<!-- PrivateAssets: the analyzers are not a package of their own, so the
		     reference must not turn into a package dependency -->
		<ProjectReference Include="..\ZeppelinForms.Analyzers\ZeppelinForms.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
	</ItemGroup>

	<!-- The analyzer assembly goes into analyzers/dotnet/cs of this package: an
	     application referencing ZeppelinForms gets the ZF diagnostics with it,
	     as it does with a project reference.
	     Pack runs this target with TargetFramework=net10.0 as a global property,
	     and the MSBuild task passes global properties on: the analyzers, which
	     are netstandard2.0, then answered with a net10.0 path that was never
	     built. RemoveProperties lets them evaluate with their own framework -->
	<Target Name="_ZfAnalyzersInPackage">
		<MSBuild Projects="..\ZeppelinForms.Analyzers\ZeppelinForms.Analyzers.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)" RemoveProperties="TargetFramework;TargetFrameworks;RuntimeIdentifier;SelfContained">
			<Output TaskParameter="TargetOutputs" ItemName="_ZfAnalyzerAssembly" />
		</MSBuild>

		<ItemGroup>
			<TfmSpecificPackageFile Include="@(_ZfAnalyzerAssembly)" PackagePath="analyzers/dotnet/cs" />
		</ItemGroup>
	</Target>

</Project>