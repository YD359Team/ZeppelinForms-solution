<Project>
	<!-- Comes with the ZeppelinForms package into every application that references it,
       directly or through a library.

       Style sheets find the controls they name in registrations the ZeppelinForms
       generator writes into each assembly. For assemblies built without the generator
       the framework can also enumerate the loaded assemblies — which trimming breaks
       and native AOT can't do. A trimmed or AOT publish turns the enumeration off, and
       the trimmer removes it -->
	<ItemGroup Condition="'$(PublishTrimmed)' == 'true' or '$(PublishAot)' == 'true'">
		<RuntimeHostConfigurationOption Include="ZeppelinForms.Styling.ScanAssemblies"
										Value="false"
										Trim="true" />
	</ItemGroup>

	<!-- Markup: every *.zfml of the project goes to the generator, which compiles it into
       the C# of its class (x:Class). The style sheets go too, by their paths only: a
       StyleSheet="…" of the markup is checked against them -->
	<ItemGroup>
		<AdditionalFiles Include="**\*.zfml" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
		<AdditionalFiles Include="**\*.zss" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
	</ItemGroup>

	<!-- A class's parts under its code file in Solution Explorer and Rider:
       MainForm.design.cs (the controls and InitializeComponent) and MainForm.zfml (the
       same as markup) nest under MainForm.cs, as WinForms' Form1.Designer.cs does. Only
       those with a MainForm.cs beside them: the names each code file would have for its
       parts are made from Compile, and Update touches the files that are there -->
	<ItemGroup>
		<_ZfDesignParts Include="@(Compile->'%(RelativeDir)%(Filename).design.cs')" />
		<_ZfMarkupParts Include="@(Compile->'%(RelativeDir)%(Filename).zfml')" />

		<!-- "MainForm.design" → "MainForm.cs" -->
		<Compile Update="@(_ZfDesignParts)" DependentUpon="$([System.IO.Path]::GetFileNameWithoutExtension('%(Filename)')).cs" />
		<AdditionalFiles Update="@(_ZfMarkupParts)" DependentUpon="%(Filename).cs" />
		<None Update="@(_ZfMarkupParts)" DependentUpon="%(Filename).cs" />

		<_ZfDesignParts Remove="@(_ZfDesignParts)" />
		<_ZfMarkupParts Remove="@(_ZfMarkupParts)" />
	</ItemGroup>

	<!-- Style sheets are read at run time and never compiled. A .zss Visual Studio gave
       the C# build action — added as a code file and renamed, or set by hand — went to
       the C# compiler, and the build failed on its braces and colons with "identifier
       expected" and "; expected". Imported after the project's own items, this takes it
       out of Compile whatever the project says -->
	<ItemGroup>
		<Compile Remove="**\*.zss" />
	</ItemGroup>
</Project>