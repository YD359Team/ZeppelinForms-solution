<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

	<PropertyGroup>
		<TargetFramework>net10.0-browser</TargetFramework>
		<RootNamespace>ZF_Wasm</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- Exe, а не WinExe: подсистемы Windows в браузере нет.
         RuntimeIdentifier не пишем — SDK сам ставит browser-wasm -->
		<OutputType>Exe</OutputType>
		<WasmMainJSPath>wwwroot\main.js</WasmMainJSPath>
		<!-- нативный Skia перелинковывается в модуль приложения;
         требует workload wasm-tools и Emscripten -->
		<WasmBuildNative>true</WasmBuildNative>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\ZeppelinForms.Browser\ZeppelinForms.Browser.csproj" />
		<ProjectReference Include="..\ZF SharedLib\ZF SharedLib.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Link кладёт файл в wwwroot, откуда он попадает в манифест
         статики с типом text/javascript. Сырая копия через
         WasmExtraFilesToDeploy в манифест не попадает и отдаётся
         вовсе без Content-Type — модулем такое не загрузить -->
		<Content Include="..\..\src\ZeppelinForms.Browser\zf.js" Link="wwwroot\zf.js" />
	</ItemGroup>

	<ItemGroup>
		<!-- шрифт в виртуальную ФС: по этому пути его найдёт
         SKTypeface.FromFile внутри SkiaFontCache -->
		<WasmFilesToIncludeInFileSystem Include="fonts\Inter-Regular.ttf" TargetPath="/fonts/Inter-Regular.ttf" />
	</ItemGroup>

</Project>