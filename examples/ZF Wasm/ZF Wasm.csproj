<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

	<PropertyGroup>
		<TargetFramework>net10.0-browser</TargetFramework>
		<RootNamespace>ZF_Wasm</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- Exe, а не WinExe: подсистемы Windows в браузере нет.
         RuntimeIdentifier не пишем — SDK сам ставит browser-wasm -->
		<OutputType>Exe</OutputType>
		<WasmMainJSPath>wwwroot\main.js</WasmMainJSPath>
		<!-- нативный Skia перелинковывается в модуль приложения;
         требует workload wasm-tools и Emscripten -->
		<WasmBuildNative>true</WasmBuildNative>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\ZeppelinForms.Browser\ZeppelinForms.Browser.csproj" />
		<ProjectReference Include="..\ZF SharedLib\ZF SharedLib.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- общие с остальными примерами картинки -->
		<SharedAsset Include="..\ZF SharedLib\Assets\**\*" />
	</ItemGroup>

	<!-- копируем их в настоящий wwwroot, а не объявляем через Content с Link:
       WebAssembly-SDK делает статическим ресурсом файл по его настоящему пути
       внутри проекта, а не по значению Link. Ссылка попадала в выход, но
       маршрута на сервере не получала — сервер отдавал на её адрес index.html
       со статусом 200, и PreloadAsync записывал в файловую систему HTML -->
	<Target Name="CopySharedAssets" BeforeTargets="PrepareForBuild">
		<Copy SourceFiles="@(SharedAsset)"
		      DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\Assets"
		      SkipUnchangedFiles="true" />
	</Target>

	<ItemGroup>
		<Content Remove="wwwroot\zf.js" />
	</ItemGroup>

	<ItemGroup>
		<None Include="wwwroot\zf.js" />
	</ItemGroup>

	<!-- шрифт лежит в wwwroot и подхватывается сам; zf.js приезжает
       из ZeppelinForms.Browser. Объявлять их нельзя: второе объявление
       даст два ресурса с одним маршрутом и уронит сборку -->

</Project>