<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

	<PropertyGroup>
		<TargetFramework>net10.0-browser</TargetFramework>
		<RootNamespace>ZF_Wasm</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- Exe, а не WinExe: подсистемы Windows в браузере нет.
         RuntimeIdentifier не пишем — SDK сам ставит browser-wasm -->
		<OutputType>Exe</OutputType>
		<WasmMainJSPath>wwwroot\main.js</WasmMainJSPath>
		<!-- нативный Skia перелинковывается в модуль приложения;
         требует workload wasm-tools и Emscripten -->
		<WasmBuildNative>true</WasmBuildNative>
	</PropertyGroup>

	<ItemGroup>
	  <None Include="wwwroot\fonts\Inter-Regular.ttf" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\ZeppelinForms.Browser\ZeppelinForms.Browser.csproj" />
		<ProjectReference Include="..\ZF SharedLib\ZF SharedLib.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="..\ZF SharedLib\Assets\**\*"
		         Link="wwwroot\Assets\%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<!-- шрифт и ресурсы лежат в wwwroot и раздаются как обычная статика;
       в файловую систему их кладёт BrowserPlatform.PreloadAsync при старте.
       Объявлять их элементами нельзя: wwwroot подхватывается сам,
       и второе объявление даст два ресурса с одним маршрутом -->

</Project>