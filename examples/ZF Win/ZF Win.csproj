<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ZF_Win</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ZeppelinForms.Windows\ZeppelinForms.Windows.csproj" />
    <ProjectReference Include="..\ZF SharedLib\ZF SharedLib.csproj" />
  </ItemGroup>

	<ItemGroup>
		<!-- ресурсы общие с остальными примерами: Link возвращает им
         относительный путь Assets\..., которого ждёт Image.LoadAsset -->
		<None Include="..\ZF SharedLib\Assets\**\*"
		      Link="Assets\%(RecursiveDir)%(Filename)%(Extension)"
		      CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
