<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<packageSources>
		<!-- Ignore machine-level feeds (e.g. github-yd359): the solution
         restores only from nuget.org, so the build stays reproducible
         and NU1507 never fires under central package management. -->
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
	</packageSources>
</configuration>