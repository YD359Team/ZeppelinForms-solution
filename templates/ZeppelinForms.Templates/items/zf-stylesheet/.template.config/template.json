{
  "$schema": "http://json.schemastore.org/template",
  "author": "YD359Team",
  "classifications": [
    "ZeppelinForms",
    "Style"
  ],
  "identity": "ZeppelinForms.ItemTemplates.StyleSheet",
  "groupIdentity": "ZeppelinForms.ItemTemplates.StyleSheet",
  "name": "ZeppelinForms Style Sheet",
  "description": "A .zss style sheet: selectors of controls, classes and names, theme colors, variables, transitions.",
  "shortName": "zf-stylesheet",
  "defaultName": "Styles",
  "sourceName": "Styles",
  "preferNameDirectory": false,
  "tags": {
    "language": "C#",
    "type": "item"
  },
  "primaryOutputs": [
    {
      "path": "Styles.zss"
    }
  ],
  "postActions": [
    {
      "condition": "(HostIdentifier != \"dotnetcli\" && HostIdentifier != \"dotnetcli-preview\")",
      "description": "Opens Styles.zss in the editor.",
      "manualInstructions": [],
      "actionId": "84C0DA21-51C8-4541-9940-6CA19AF04EE6",
      "id": "openInEditor",
      "args": {
        "files": "0"
      },
      "continueOnError": true
    }
  ]
}
