<Project Sdk="Microsoft.NET.Sdk">

	<!-- The templates of dotnet new, and of the IDEs that show them: a form with its design
	     in a .design.cs, a form in markup, a style sheet.

	         dotnet new install ZeppelinForms.Templates
	         dotnet new zf-form -n OrderForm

	     A package of content only: no assembly, no symbols -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<PackageType>Template</PackageType>
		<PackageId>ZeppelinForms.Templates</PackageId>
		<Title>ZeppelinForms templates</Title>
		<Description>Templates of ZeppelinForms for dotnet new, Rider and Visual Studio: zf-form — a form with its controls in Form1.design.cs and its behaviour in Form1.cs; zf-form-markup — a form in .zfml markup; zf-stylesheet — a .zss style sheet.</Description>
		<PackageTags>$(PackageTags);dotnet-new;templates</PackageTags>

		<IncludeContentInPack>true</IncludeContentInPack>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<ContentTargetFolders>content</ContentTargetFolders>
		<IncludeSymbols>false</IncludeSymbols>

		<!-- .template.config starts with a dot: pack leaves such folders out unless told -->
		<NoDefaultExcludes>true</NoDefaultExcludes>

		<!-- a template package has no lib/: NU5128 asks for one -->
		<NoWarn>$(NoWarn);NU5128</NoWarn>

		<!-- the templates' C# is content to copy, not code of this project -->
		<EnableDefaultItems>false</EnableDefaultItems>
	</PropertyGroup>

	<!-- items/ — the item templates; the project templates come next to them -->
	<ItemGroup>
		<Content Include="items\**\*" Exclude="items\**\bin\**;items\**\obj\**" />
	</ItemGroup>

</Project>
