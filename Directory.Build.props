<Project>
	<PropertyGroup>
		<Version>0.14.0</Version>
		<Authors>YD359Team</Authors>
		<Company>YD359Team</Company>
		<Product>ZeppelinForms</Product>
		<PackageProjectUrl>https://github.com/YD359Team/ZeppelinForms-solution</PackageProjectUrl>
		<RepositoryUrl>https://github.com/YD359Team/ZeppelinForms-solution</RepositoryUrl>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageIcon>ZF_13_medium.jpg</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>zeppelinforms;ui;gui;controls;cross-platform;skiasharp;desktop;android;wasm</PackageTags>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<!-- The files the metadata above names must be inside every package:
       without them pack fails with NU5030 (license), NU5046 (icon) and
       NU5039 (readme). Harmless in projects that are not packed. -->
	<ItemGroup>
		<None Include="$(MSBuildThisFileDirectory)LICENSE.txt" Pack="true" PackagePath="\" Visible="false" />
		<None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
		<None Include="$(MSBuildThisFileDirectory)assets\ZF_13_medium.jpg" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

	<PropertyGroup>
		<!-- Предупреждение, которое печатается и пролистывается, ничем
         не отличается от его отсутствия. Ронять сборку — единственный
         способ заставить их чинить. -->
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>

		<!-- Мёртвые поля и неиспользуемые члены: за 0.9–0.10 их вычищали
         трижды вручную (_disposed в TextInputControl, поля Win32Window,
         DefaultFont и CachedImage в Skia). Это работа компилятора. -->
		<AnalysisLevel>latest</AnalysisLevel>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
	</PropertyGroup>
</Project>