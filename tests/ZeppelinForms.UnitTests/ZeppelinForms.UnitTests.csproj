<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<OutputType>Exe</OutputType>
	<TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
	<UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />

    <!-- the generators are tested by running them on a compilation of their own -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

	<ItemGroup>
		<!-- a test running past a minute is named in the log while it runs: a hang shows
         which test it is instead of a step that just never ends -->
		<Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />

		<!-- the font GlesSkiaParityTests draws text with: one file for both renderers, the
		     examples' own, not a copy -->
		<None Include="..\..\examples\ZF Wasm\wwwroot\fonts\Inter-Regular.ttf" Link="Fonts\Inter-Regular.ttf" CopyToOutputDirectory="PreserveNewest" Visible="false" />
	</ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ZeppelinForms.Gles\ZeppelinForms.Gles.csproj" />
    <ProjectReference Include="..\..\src\ZeppelinForms.Linux\ZeppelinForms.Linux.csproj" />
    <ProjectReference Include="..\..\src\ZeppelinForms.Windows\ZeppelinForms.Windows.csproj" />
    <ProjectReference Include="..\..\src\ZeppelinForms\ZeppelinForms.csproj" />
    <ProjectReference Include="..\..\tools\ZeppelinForms.Design\ZeppelinForms.Design.csproj" />
    <ProjectReference Include="..\..\src\ZeppelinForms.Analyzers\ZeppelinForms.Analyzers.csproj" />
    <ProjectReference Include="..\..\tools\ZeppelinForms.LanguageServer\ZeppelinForms.LanguageServer.csproj" />
  </ItemGroup>

</Project>
